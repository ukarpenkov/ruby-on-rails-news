<article class="story">
  <div class="story__heading">
    <p class="story__rubric"><%= @article.rubric.title %></p>
    <%= render "favorites/button", article: @article %>
  </div>
  <h1 class="story__title"><%= @article.title %></h1>
  <p class="story__body"><%= @article.body %></p>

  <p class="story__back">
    <%= link_to "Back to news", root_path %>
  </p>
</article>
