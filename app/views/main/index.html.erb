<section class="rubrics">
  <h1>Rubrics</h1>

  <% if @rubrics.blank? %>
    <p>no rubrics</p>
  <% else %>
    <ul class="rubrics__list">
      <% @rubrics.each do |rubric| %>
        <li class="rubric <%= "rubric--active" if params[:rubric_id].to_s == rubric.id.to_s %>">
          <%= link_to root_path(rubric_id: rubric.id), class: "rubric__link" do %>
            <h2 class="rubric__title"><%= rubric.title %></h2>
            <p class="rubric__description"><%= rubric.description %></p>
          <% end %>
        </li>
      <% end %>
      <li class="rubric rubric--all">
        <%= link_to "Все рубрики", root_path, class: "rubric__link" %>
      </li>
    </ul>
  <% end %>
</section>

<section class="search">
  <h1>Search</h1>

  <%= form_with url: root_path, method: :get, class: "search__form" do |form| %>
    <%= form.hidden_field :rubric_id, value: params[:rubric_id] %>
    <%= form.text_field :q, value: params[:q], placeholder: "Поиск по новостям", class: "search__input" %>
    <%= form.submit "Найти", class: "search__button" %>
  <% end %>
</section>

<section
  class="hits"
  data-controller="infinite-scroll"
  data-infinite-scroll-url-value="<%= root_path(rubric_id: params[:rubric_id].presence, q: params[:q].presence) %>"
  data-infinite-scroll-page-value="<%= @page %>"
  data-infinite-scroll-has-more-value="<%= @has_more %>"
>
  <h1>Today</h1>

  <% if @articles.blank? %>
    <p>no articles</p>
  <% else %>
    <div data-infinite-scroll-target="list">
      <%= render partial: "hit", collection: @articles, as: :article %>
    </div>

    <% if @has_more %>
      <div data-infinite-scroll-target="sentinel" class="hits__sentinel"></div>
      <p data-infinite-scroll-target="status" class="hits__status" hidden></p>
    <% end %>
  <% end %>
</section>
