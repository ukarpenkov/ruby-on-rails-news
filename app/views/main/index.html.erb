<section class="rubrics">
  <h1>Rubrics</h1>

  <% if @rubrics.blank? %>
    <p>no rubrics</p>
  <% else %>
    <ul class="rubrics__list">
      <% @rubrics.each do |rubric| %>
        <li class="rubric">
          <h2 class="rubric__title"><%= rubric.title %></h2>
          <p class="rubric__description"><%= rubric.description %></p>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section class="hits">
  <h1>Today</h1>

  <% if @hits.blank? %>
    <p>no articles</p>
  <% else %>
    <% @hits.each do |article| %>
      <%= link_to article_path(article), class: "hit" do %>
        <p class="hit__rubric"><%= article.rubric.title %></p>
        <h2 class="hit__title"><%= article.title %></h2>
        <p class="hit__body"><%= article.body %></p>
      <% end %>
    <% end %>
  <% end %>
</section>
