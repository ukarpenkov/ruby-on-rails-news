<section class="auth">
  <h1>Вход</h1>

  <% if @error || flash[:alert] %>
    <p class="auth__error"><%= @error || flash[:alert] %></p>
  <% end %>

  <%= form_with url: login_path, class: "auth__form" do |form| %>
    <label class="auth__field">
      Логин
      <%= form.text_field :login, required: true, autocomplete: "username" %>
    </label>

    <label class="auth__field">
      Пароль
      <%= form.password_field :password, required: true, autocomplete: "current-password" %>
    </label>

    <%= form.submit "Войти", class: "auth__submit" %>
  <% end %>

  <p class="auth__divider">или</p>

  <%= button_to "Войти через Facebook", "/auth/facebook",
        class: "auth__facebook",
        form: { class: "auth__facebook-form", data: { turbo: false } } %>

  <p class="auth__hint">
    <%= link_to "Нет аккаунта? Регистрация", signup_path %>
  </p>
</section>
